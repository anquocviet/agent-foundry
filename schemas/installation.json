{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentfoundry.installation/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agentfoundry.installation/v1"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "logical_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ownership": {
            "enum": [
              "managed_file",
              "managed_block"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "addon": {
            "enum": ["engineering-wisdom", null]
          },
          "adapter": {
            "enum": ["claude", null]
          }
        },
        "required": [
          "logical_id",
          "target",
          "ownership",
          "source",
          "sha256",
          "mode"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "binary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "generation",
    "version",
    "source",
    "payload_digest",
    "entries",
    "binary_digest"
  ],
  "additionalProperties": false
}
