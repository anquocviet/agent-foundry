{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {"const": "agentfoundry.activation/v1"},
    "id": {"type": "string", "pattern": "^[0-9a-fA-F]{1,128}$"},
    "root_identity": {"type": "string"},
    "before_state": {"$ref": "#/$defs/digest"},
    "after_state": {"$ref": "#/$defs/digest"},
    "before_binary": {"$ref": "#/$defs/digest"},
    "target": {
      "type": "object",
      "properties": {
        "version": {"type": "string"},
        "source": {"type": "string"},
        "payload_digest": {"$ref": "#/$defs/digest"},
        "binary_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["version", "source", "payload_digest", "binary_digest"]
    },
    "release": {"anyOf": [{"type": "null"}, {"$ref": "release.json"}]},
    "mode": {"type": "integer", "minimum": 0, "maximum": 511}
  },
  "required": ["schema", "id", "root_identity", "before_state", "after_state", "before_binary", "target", "release", "mode"],
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
