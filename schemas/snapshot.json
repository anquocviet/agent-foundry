{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agentfoundry.snapshot/v1"
    },
    "root_identity": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "allOf": [
        {"contains": {"properties": {"path": {"const": ".agentfoundry/config.json"}}, "required": ["path"]}},
        {"contains": {"properties": {"path": {"const": ".agentfoundry/state/manifest.json"}}, "required": ["path"]}}
      ],
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "presence": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "absent"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                },
                "required": [
                  "kind",
                  "digest",
                  "mode"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "path",
          "presence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "root_identity",
    "generation",
    "config_digest",
    "state_digest",
    "entries"
  ],
  "additionalProperties": false
}
